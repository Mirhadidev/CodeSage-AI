# Copy this file to .env and paste your real key.
# Never commit the real .env file — .gitignore already excludes it.
OPENAI_API_KEY=sk-your-key-here

# ---------------------------------------------------------------------------
# Optional overrides.
#
# These OVERRIDE the defaults in src/config.py, so only uncomment a line if you
# actually want to change it. The values shown are the app's current defaults.
# ---------------------------------------------------------------------------

# gpt-4o is the default because weaker models invent bugs when reviewing code.
# DEFAULT_MODEL=gpt-4o

# 0.3, not lower. Near-greedy decoding (0.0-0.1) is a known cause of the model
# getting stuck repeating itself — "six six six six…" until the token limit.
# DEFAULT_TEMPERATURE=0.3

# Hard ceiling on answer length, so a runaway loop cannot bill forever.
# MAX_OUTPUT_TOKENS=3000
